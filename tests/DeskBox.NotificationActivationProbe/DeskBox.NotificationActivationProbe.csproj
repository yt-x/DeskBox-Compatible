<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Fork floor: 17763 (Windows 10 1809 / LTSC 2019); upstream ships 10.0.19041. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../../src/DeskBox/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <Compile Include="../../src/DeskBox/Services/NativeAppNotificationService.cs" Link="NativeAppNotificationService.cs" />
    <Compile Include="../../src/DeskBox/Services/NativeNotificationActivationBootstrap.cs" Link="NativeNotificationActivationBootstrap.cs" />
    <Compile Include="../../src/DeskBox/Services/NativeNotificationActivationEnvelopeStore.cs" Link="NativeNotificationActivationEnvelopeStore.cs" />
  </ItemGroup>
</Project>
